# Copy to .env and fill these values outside version control.
# Use independent cryptographically random values of at least 32 characters.
HEGEMONE_MEDIA_SECRET=
# Optional separate encryption material for saved provider keys (32+ random characters).
# Leave unset to derive from the media secret; back it up before storing keys.
# HEGEMONE_SETTINGS_SECRET=
# Required only for first installation. Remove after creating the administrator.
HEGEMONE_SETUP_TOKEN=
HEGEMONE_PORT=8000
# HEGEMONE_PUBLIC_URL=http://localhost:8000

# Language for generated instructions and server notifications (en or nl).
# HEGEMONE_LANGUAGE=en

# Language for newly generated AI text: en or nl (independent of browser language).
# HEGEMONE_AI_LANGUAGE=en

# Optional deployment overrides. Leave these variables unset to configure providers in the app.
# An explicitly empty provider key disables it and overrides any saved key.
# HEGEMONE_LLM_BASE_URL=
# HEGEMONE_LLM_API_KEY=
# HEGEMONE_LLM_MODEL=
# HEGEMONE_EMBED_BASE_URL=
# HEGEMONE_EMBED_API_KEY=
# HEGEMONE_EMBED_MODEL=
# Enable only after configuring the required providers.
# HEGEMONE_TRIAGE_ENABLED=0
# HEGEMONE_WIKI_COMPILE_ENABLED=0
